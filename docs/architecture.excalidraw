      "verticalAlign": "middle",
      "baseline": 18,
      "containerId": null,
      "originalText": "\u2605 HUMAN-IN-THE-LOOP (HITL) \u2014 OUR CORE DIFFERENTIATOR \u2605",
      "lineHeight": 1.25
    },
    {
      "id": "8de07bb1-e",
      "type": "rectangle",
      "x": 550,
      "y": 700,
      "width": 560,
      "height": 260,
